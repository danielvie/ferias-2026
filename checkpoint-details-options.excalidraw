    {"id":"b-note1","type":"text","x":1680,"y":1250,"width":1040,"height":25,"text":"Best when discovering activities. A suggestion stays visible while you review your saved list.","fontSize":20,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"b-note2","type":"text","x":1680,"y":1292,"width":1040,"height":75,"text":"White throughout. Blue title and thicker number outline / chevron identify the open checkpoint.\nThe 60/40 split uses a gutter, not a vertical divider. Below 720 px, ideas stack after activities.\nSave adds the suggestion to this checkpoint, never to the calendar. Hide the ideas column when exhausted.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"b-m-note","type":"text","x":2780,"y":1034,"width":370,"height":100,"text":"Tradeoff: ideas take width on\ndesktop and height on phones.\nNo separate details panel.\n44 px touch targets.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
