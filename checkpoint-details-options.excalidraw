    {"id":"c-note1","type":"text","x":40,"y":2720,"width":1040,"height":25,"text":"Best for longer lists. Ideas never add another section below the saved activities.","fontSize":20,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"c-note2","type":"text","x":40,"y":2762,"width":1040,"height":75,"text":"No background highlight or vertical bars. Use blue and thicker outlines for selection.\nTabs use a short 3 px underline, not a filled pill. The toolbar stays visible in either tab.\nTradeoff: comparing ideas with saved activities takes a tab switch. Remember the tab per checkpoint.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"c-m-note","type":"text","x":1140,"y":2474,"width":370,"height":100,"text":"The phone shows the other tab.\nSave adds an idea to Activities.\nAdd activity still opens the form.\n44 px tab and button targets.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
