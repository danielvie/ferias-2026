    {"id":"a-note1","type":"text","x":40,"y":1220,"width":1040,"height":25,"text":"Recommended. Smallest change; the open checkpoint still expands in place.","fontSize":20,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"a-note2","type":"text","x":40,"y":1262,"width":1040,"height":50,"text":"No selection fill or vertical bars. Blue title, 2.5 px number outline and chevron mark the open stop.\n32 px desktop buttons; 44 px phone targets. Number handles still reorder. The menu keeps route moves.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"a-m-note","type":"text","x":1140,"y":942,"width":370,"height":100,"text":"On phones, actions wrap below\nthe heading instead of shrinking\nthe tap targets. Activity ideas\nexpand below the empty message.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
