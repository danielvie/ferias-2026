    {"id":"title","type":"text","x":40,"y":30,"width":1200,"height":40,"text":"Places: checklists attached to a city","fontSize":32,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"intro","type":"text","x":40,"y":85,"width":1250,"height":48,"text":"Design discussion · Arriving and leaving belong to one specific city visit.\nA, B and C are earlier ideas. D adds spacing and light backgrounds, to the right.","fontSize":18,"fontFamily":5,"strokeColor":"#526178"},

    {"id":"a-title","type":"text","x":40,"y":175,"width":560,"height":34,"text":"A. Before and after the city","fontSize":25,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"a-description","type":"text","x":40,"y":215,"width":560,"height":52,"text":"Checklist controls sit above or below each city.\nDirection is shown in the label, not just position.","fontSize":17,"fontFamily":5,"strokeColor":"#526178"},
