    {"id":"c-intro","type":"text","x":1350,"y":215,"width":1200,"height":50,"text":"A plus above the city adds an arriving checklist. A plus below adds a leaving checklist.\nThe annotations outside the mockup explain ownership; they are not extra labels in the UI.","fontSize":17,"fontFamily":5,"strokeColor":"#526178"},
