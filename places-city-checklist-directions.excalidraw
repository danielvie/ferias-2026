    {"id":"migration-caption","type":"text","x":40,"y":1980,"width":1080,"height":50,"text":"The original starting city owns the leaving checklist. Items and their completion are preserved.\nThese sketches are proposals; they do not change the app or its data.","fontSize":17,"fontFamily":5,"strokeColor":"#526178"},

