  "elements": [
    {"id":"qs-title","type":"text","x":40,"y":24,"width":1480,"height":45,"text":"Quick start / first-run sample trip","fontSize":36,"fontFamily":5,"strokeColor":"#242933","roughness":0},
    {"id":"qs-intro","type":"text","x":40,"y":88,"width":1480,"height":25,"text":"Fill the existing setup form. Review or edit before saving. No automatic trip creation or bookings.","fontSize":20,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"qs-empty","type":"frame","name":"1. First run / no saved trip","x":40,"y":170,"width":640,"height":460,"strokeColor":"#d4dbe5"},
    {"id":"qs-brand","type":"text","frameId":"qs-empty","x":72,"y":198,"width":560,"height":22.5,"text":"Belgium, together","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"qs-heading","type":"text","frameId":"qs-empty","x":72,"y":250,"width":560,"height":42.5,"text":"Itinerary","fontSize":34,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"qs-copy","type":"text","frameId":"qs-empty","x":72,"y":316,"width":560,"height":50,"text":"A place for each day of your trip.\nAdd your dates and cities, then make it yours.","fontSize":20,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"qs-manual","type":"rectangle","frameId":"qs-empty","x":72,"y":398,"width":206,"height":44,"strokeColor":"#345ec2","backgroundColor":"#345ec2","fillStyle":"solid","strokeWidth":1,"roughness":0,"roundness":{"type":3}},
