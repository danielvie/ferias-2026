    {"id":"qs-pane-rule","type":"line","frameId":"qs-pane","x":832,"y":254,"width":656,"height":0,"points":[[0,0],[656,0]],"strokeColor":"#e1e6ee","roughness":0},
    {"id":"qs-sample-note","type":"text","frameId":"qs-pane","x":832,"y":280,"width":656,"height":45,"text":"These are sample details. Change anything, then save.\nNo activities or bookings are added.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
