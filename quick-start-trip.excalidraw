    {"id":"qs-calendar-label","type":"text","frameId":"qs-pane","x":856,"y":612,"width":608,"height":25,"text":"Shared trip-date calendar","fontSize":20,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"qs-calendar-range","type":"text","frameId":"qs-pane","x":856,"y":654,"width":608,"height":22.5,"text":"Today to today + 6 days / seven days selected","fontSize":18,"fontFamily":5,"strokeColor":"#345ec2"},
    {"id":"qs-cities-label","type":"text","frameId":"qs-pane","x":832,"y":736,"width":656,"height":22.5,"text":"Cities, in trip order","fontSize":18,"fontFamily":5,"strokeColor":"#242933"},
