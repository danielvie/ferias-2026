    {"id":"qs-button-t","type":"text","frameId":"qs-empty","x":306,"y":409,"width":142,"height":22.5,"text":"Quick start","fontSize":18,"fontFamily":5,"textAlign":"center","strokeColor":"#345ec2"},
    {"id":"qs-helper","type":"text","frameId":"qs-empty","x":72,"y":470,"width":560,"height":45,"text":"Quick start fills sample details for a new trip.\nReview them before saving.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"qs-open","type":"text","frameId":"qs-empty","x":72,"y":548,"width":560,"height":45,"text":"Already have a trip?\nUse Open trip link above.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
