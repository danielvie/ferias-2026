    {"id":"qs-save","type":"rectangle","frameId":"qs-pane","x":832,"y":902,"width":224,"height":44,"strokeColor":"#345ec2","backgroundColor":"#345ec2","fillStyle":"solid","strokeWidth":1,"roughness":0,"roundness":{"type":3}},
    {"id":"qs-save-t","type":"text","frameId":"qs-pane","x":844,"y":913,"width":200,"height":22.5,"text":"Save trip details","fontSize":18,"fontFamily":5,"textAlign":"center","strokeColor":"#ffffff"},
    {"id":"qs-cancel","type":"rectangle","frameId":"qs-pane","x":1072,"y":902,"width":120,"height":44,"strokeColor":"#c8d1df","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"roughness":0,"roundness":{"type":3}},
    {"id":"qs-cancel-t","type":"text","frameId":"qs-pane","x":1084,"y":913,"width":96,"height":22.5,"text":"Cancel","fontSize":18,"fontFamily":5,"textAlign":"center","strokeColor":"#345ec2"},
    {"id":"qs-first-note","type":"text","x":40,"y":676,"width":640,"height":75,"text":"Only on the empty first-run screen.\nAdd trip details stays blank.\nOn phones, the two buttons wrap if needed.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"qs-state-note","type":"text","x":40,"y":792,"width":640,"height":100,"text":"Cancel creates nothing and returns focus to Quick start.\nSave creates a normal editable trip with seven empty days.\nSave errors keep the edited values for retry.\nAfter saving, Quick start is no longer shown.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"},
    {"id":"qs-calendar-note","type":"text","x":800,"y":1030,"width":720,"height":75,"text":"The dashed calendar box is a component placeholder.\nImplementation reuses the complete date-range picker.\nCities use the existing editable inputs and order controls.","fontSize":18,"fontFamily":5,"strokeColor":"#526174"}
  ],
