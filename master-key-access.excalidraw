    {"id":"locked-heading","type":"text","x":65,"y":165,"width":460,"height":30,"text":"Gerenciar todas as viagens                Fechar","fontSize":20,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":4,"version":1,"versionNonce":4,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"locked-copy","type":"text","x":65,"y":215,"width":455,"height":90,"text":"Digite a senha para ver as viagens\nsalvas neste banco.\n\nSenha","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":5,"version":1,"versionNonce":5,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
