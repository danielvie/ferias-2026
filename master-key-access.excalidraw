    {"id":"remembered-copy","type":"text","x":1185,"y":165,"width":495,"height":320,"text":"Minhas viagens                         Fechar\n\nViagens que você já abriu neste navegador.\n\nBélgica 2026\n02/12/2026 a 15/12/2026\nDaniel · owner · ca14f1f1\nViagem atual    Esquecer neste navegador\n\nBélgica 2026\n02/12/2026 a 15/12/2026\nDaniel · owner · 56a13aed\nAbrir viagem    Esquecer neste navegador","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":19,"version":1,"versionNonce":19,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false}
