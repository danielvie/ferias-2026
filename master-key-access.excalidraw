    {"id":"locked-help","type":"text","x":65,"y":375,"width":450,"height":50,"text":"Ao abrir, a viagem fica disponível\nem Minhas viagens neste navegador.","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":14,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":8,"version":1,"versionNonce":8,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
