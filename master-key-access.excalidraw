    {"id":"list-copy","type":"text","x":625,"y":165,"width":460,"height":300,"text":"Gerenciar todas as viagens           Fechar\n\nViagens salvas\n\nBélgica 2026\n02/12/2026 a 15/12/2026\nDaniel · organizador · ca14f1f1\nAbrir viagem    Excluir viagem\n\nBélgica 2026\n02/12/2026 a 15/12/2026\nDaniel · organizador · 56a13aed\nAbrir viagem    Excluir viagem","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":12,"version":1,"versionNonce":12,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"list-reset","type":"text","x":625,"y":490,"width":400,"height":25,"text":"Voltar à senha","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":13,"version":1,"versionNonce":13,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"states","type":"text","x":40,"y":580,"width":680,"height":250,"text":"Estados da interação\n\nCarregando ou abrindo: controles desativados.\nSenha errada: limpar campo e mostrar erro.\nExcluir: confirmar nome e ID. Sem desfazer.\nCancelar: nenhum dado é alterado.\nSucesso: excluir do banco e do navegador.\nFalha: manter entrada e permitir tentar de novo.\nViagem ativa excluída: voltar à página inicial.\nOutras viagens continuam disponíveis.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":14,"version":1,"versionNonce":14,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"mobile-panel","type":"rectangle","x":770,"y":580,"width":320,"height":400,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"seed":15,"version":1,"versionNonce":15,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"mobile-copy","type":"text","x":790,"y":600,"width":280,"height":350,"text":"Celular: mesmo fluxo\n\nGerenciar todas\nas viagens           Fechar\n\nViagens salvas\n\nBélgica 2026\n02/12/2026 a 15/12/2026\nDaniel · organizador · ca14f1f1\n\nAbrir viagem    Excluir viagem\n\nVoltar à senha","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":16,"version":1,"versionNonce":16,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"accessibility","type":"text","x":40,"y":865,"width":670,"height":100,"text":"Teclado e layout\n\nDiálogo nativo mantém o foco. Escape fecha.\nAo listar, foco segue para Viagens salvas.\nControles de toque mantêm altura de 44 px.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":17,"version":1,"versionNonce":17,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false}
