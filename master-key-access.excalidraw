  "elements": [
    {"id":"title","type":"text","x":40,"y":20,"width":1050,"height":35,"text":"Master key access: selected design","fontSize":28,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":25,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":1,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"subtitle","type":"text","x":40,"y":65,"width":1060,"height":50,"text":"Trips > Use master key, or Open trip link > Use master key instead.\nReuse existing modal, fields and list. No separate admin workspace.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":2,"version":1,"versionNonce":2,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"locked-panel","type":"rectangle","x":40,"y":145,"width":510,"height":395,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"seed":3,"version":1,"versionNonce":3,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"locked-heading","type":"text","x":65,"y":165,"width":460,"height":30,"text":"Open with master key                         Close","fontSize":20,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":4,"version":1,"versionNonce":4,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"locked-copy","type":"text","x":65,"y":215,"width":455,"height":90,"text":"Open any trip as its existing owner.\nOther members' private notes stay hidden.\n\nMaster key","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":5,"version":1,"versionNonce":5,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"password","type":"rectangle","x":65,"y":315,"width":455,"height":44,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"seed":6,"version":1,"versionNonce":6,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"password-label","type":"text","x":80,"y":325,"width":300,"height":25,"text":"[masked key input]","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":7,"version":1,"versionNonce":7,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"locked-help","type":"text","x":65,"y":375,"width":450,"height":50,"text":"Key stays in memory, never browser storage.\nOpening remembers only that trip's owner session.","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":14,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":8,"version":1,"versionNonce":8,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"show-button","type":"rectangle","x":65,"y":450,"width":150,"height":44,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"seed":9,"version":1,"versionNonce":9,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"show-label","type":"text","x":80,"y":460,"width":390,"height":25,"text":"Show trips                 Cancel","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":10,"version":1,"versionNonce":10,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"list-panel","type":"rectangle","x":600,"y":145,"width":510,"height":395,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"seed":11,"version":1,"versionNonce":11,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"list-copy","type":"text","x":625,"y":165,"width":460,"height":300,"text":"Open with master key                         Close\n\nTrips in this database\n\nBelgium 2026\n2026-12-02 to 2026-12-15\nDaniel · owner · ca14f1f1\nOpen trip\n\nBelgium 2026\n2026-12-02 to 2026-12-15\nDaniel · owner · 56a13aed\nOpen trip","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":12,"version":1,"versionNonce":12,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"list-reset","type":"text","x":625,"y":490,"width":400,"height":25,"text":"Use another key","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":13,"version":1,"versionNonce":13,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"states","type":"text","x":40,"y":580,"width":680,"height":250,"text":"Interaction states\n\nLoading: Show trips becomes Loading trips; controls disabled.\nOpening: selected button becomes Opening; controls disabled.\nEmpty: No trips in this database yet.\nInvalid/disabled key: one generic inline error; clear input.\nNetwork failure: inline error, retain draft for retry.\nClose or Escape: discard key and database list.\nSuccess: normal trip UI, existing owner identity.\nReplacement: derived sessions lose access; old links remain.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":14,"version":1,"versionNonce":14,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"mobile-panel","type":"rectangle","x":770,"y":580,"width":320,"height":400,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"seed":15,"version":1,"versionNonce":15,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"mobile-copy","type":"text","x":790,"y":600,"width":280,"height":350,"text":"Phone: same modal flow\n\nOpen with master key\n                              Close\n\nTrips in this database\n\nBelgium 2026\n2026-12-02 to 2026-12-15\nDaniel · owner · ca14f1f1\n\nOpen trip\n\nUse another key","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":16,"version":1,"versionNonce":16,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"accessibility","type":"text","x":40,"y":865,"width":670,"height":100,"text":"Keyboard and layout\n\nNative dialog traps focus; Escape closes when idle.\nFocus moves from the key input to the loaded list heading.\nExisting responsive rows wrap; touch controls retain 44px targets.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":17,"version":1,"versionNonce":17,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false}
