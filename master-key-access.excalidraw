    {"id":"show-label","type":"text","x":80,"y":460,"width":390,"height":25,"text":"Ver viagens                 Cancelar","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":10,"version":1,"versionNonce":10,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
