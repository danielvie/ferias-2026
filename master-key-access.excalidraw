    {"id":"title","type":"text","x":40,"y":20,"width":1050,"height":35,"text":"Gerenciar todas as viagens · acesso local","fontSize":28,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":25,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":1,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"subtitle","type":"text","x":40,"y":65,"width":1060,"height":50,"text":"Viagem > Minhas viagens > Gerenciar todas as viagens.\nSenha já configurada no ambiente local. Sem cadastro manual.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":16,"lineHeight":1.25,"angle":0,"strokeColor":"#1b1b1f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"seed":2,"version":1,"versionNonce":2,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
