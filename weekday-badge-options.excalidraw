    {"id":"rules-panel","type":"rectangle","x":1000,"y":720,"width":440,"height":480,"strokeColor":"#dce1e9","backgroundColor":"#f7f9fc","fillStyle":"solid","roughness":0,"groupIds":["rules"]},
    {"id":"rules-title","type":"text","x":1024,"y":746,"width":390,"height":34,"text":"Keep in every option","fontSize":25,"fontFamily":5,"strokeColor":"#242933","groupIds":["rules"]},
    {"id":"rules-text","type":"text","x":1024,"y":808,"width":392,"height":145,"text":"Blue = selected or hovered day.\nThe two S rows are Saturday and Sunday.\nWeekend style affects badges, not ticks.\nNo continuous right-side line.\nHover still opens the date and summary.","fontSize":18,"fontFamily":5,"lineHeight":1.5,"strokeColor":"#647082","groupIds":["rules"]},
