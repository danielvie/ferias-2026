    {"id":"recommendation-title","type":"text","x":1044,"y":998,"width":350,"height":30,"text":"My shortlist","fontSize":22,"fontFamily":5,"strokeColor":"#242933","groupIds":["rules"]},
    {"id":"recommendation-text","type":"text","x":1044,"y":1040,"width":350,"height":50,"text":"1 for maximum restraint.\n5 for a distinct weekend cue.","fontSize":18,"fontFamily":5,"strokeColor":"#647082","groupIds":["rules"]},
    {"id":"rules-note","type":"text","x":1024,"y":1132,"width":392,"height":50,"text":"Dense-rail behavior stays the same:\nshow a readable badge for the active row.","fontSize":17,"fontFamily":5,"strokeColor":"#647082","groupIds":["rules"]},
    {"id":"footer","type":"text","x":40,"y":1244,"width":1400,"height":30,"text":"Choose 1–5. Design exploration only; application code and trip data are unchanged.","fontSize":19,"fontFamily":5,"strokeColor":"#647082","roughness":0}
