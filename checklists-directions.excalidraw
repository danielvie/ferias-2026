    {"id":"i-state-3-items","type":"text","x":4470,"y":4300,"width":430,"height":90,"text":"[  ]  Fruit\n[  ]  Water |","fontSize":19,"fontFamily":5,"strokeColor":"#242933","lineHeight":2.3,"frameId":"i-frame"},
    {"id":"i-creation-note","type":"text","x":3390,"y":4434,"width":1540,"height":50,"text":"Insert the draft card in a stable position. Do not reshuffle the board while someone types or checks an item.\nThe selected card gets a quiet border. No animated zoom or separate editor. Keep row order editable through keyboard actions too.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"i-frame"},
    {"id":"i-tradeoff","type":"text","x":3390,"y":4502,"width":1540,"height":28,"text":"Closest to Keep's multi-list view. Tradeoff: narrower cards and more vertical scrolling when several lists are long.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"i-frame"},

    {"id":"round2-footer-box","type":"rectangle","x":3360,"y":4670,"width":1600,"height":195,"strokeColor":"#345ec2","backgroundColor":"#eef3fc","fillStyle":"solid","roughness":0},
    {"id":"round2-footer-title","type":"text","x":3384,"y":4692,"width":1550,"height":35,"text":"My pick is G. Keep the navigator; simplify everything inside the list.","fontSize":26,"fontFamily":5,"strokeColor":"#254893"},
    {"id":"round2-footer-copy","type":"text","x":3384,"y":4744,"width":1550,"height":100,"text":"All three propose editable checklist titles, inline item creation, compact rows and a completed-items section.\nTouch and keyboard actions must remain available. Checkbox targets are at least 44 px; long labels wrap.\nSave feedback stays near the editor. Failed saves keep drafts. Reduced motion switches states immediately.\nThis round proposes checklist creation only. It does not define city links, resets, templates or departure readiness.","fontSize":18,"fontFamily":5,"strokeColor":"#242933","lineHeight":1.4}
