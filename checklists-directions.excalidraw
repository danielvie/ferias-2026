    {"id":"i-layout-note","type":"text","x":3390,"y":4070,"width":1540,"height":48,"text":"One border per checklist, never per item. Each card edits in place. Clicking a navigator entry scrolls to and focuses that card.\nNew checklist inserts an empty card beside the others. Mobile uses a single column and the same pop-out navigator as H.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"i-frame"},
