    {"id":"shared-row-note","type":"text","x":990,"y":376,"width":1080,"height":54,"text":"One 44+ px action row. Owner edits on demand. Wrap long titles, never truncate.\nKeep controls visible on touch and keyboard, not hover-only.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","frameId":"baseline-frame"},
    {"id":"shared-pending-box","type":"rectangle","x":990,"y":455,"width":320,"height":50,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","fillStyle":"solid","roughness":0,"frameId":"baseline-frame"},
    {"id":"shared-pending-text","type":"text","x":1008,"y":469,"width":290,"height":23,"text":"[  ] Pending","fontSize":18,"fontFamily":5,"strokeColor":"#242933","frameId":"baseline-frame"},
    {"id":"shared-done-box","type":"rectangle","x":1330,"y":455,"width":320,"height":50,"strokeColor":"#a8c8b6","backgroundColor":"#edf6f0","fillStyle":"solid","roughness":0,"frameId":"baseline-frame"},
    {"id":"shared-done-text","type":"text","x":1348,"y":469,"width":290,"height":23,"text":"[x] Done","fontSize":18,"fontFamily":5,"strokeColor":"#286344","frameId":"baseline-frame"},
    {"id":"shared-skip-box","type":"rectangle","x":1670,"y":455,"width":400,"height":50,"strokeColor":"#dbc895","backgroundColor":"#fff4d6","fillStyle":"solid","roughness":0,"frameId":"baseline-frame"},
    {"id":"shared-skip-text","type":"text","x":1688,"y":469,"width":365,"height":23,"text":"[-] Skipped     ... > Skip / Reopen","fontSize":18,"fontFamily":5,"strokeColor":"#806318","frameId":"baseline-frame"},
    {"id":"shared-domain-rule","type":"text","x":990,"y":527,"width":1080,"height":78,"text":"Packing is complete only when every item is done.\nA departure is ready when every check is done or skipped.\nEmpty lists are never ready. A new departure starts fresh.","fontSize":20,"fontFamily":5,"strokeColor":"#242933","frameId":"baseline-frame"},
    {"id":"shared-add-box","type":"rectangle","x":990,"y":635,"width":480,"height":48,"strokeColor":"#cbd2dd","backgroundColor":"#eef3fc","fillStyle":"solid","roughness":0,"frameId":"baseline-frame"},
    {"id":"shared-add-text","type":"text","x":1008,"y":648,"width":445,"height":23,"text":"+ Add item     opens a small inline form","fontSize":18,"fontFamily":5,"strokeColor":"#345ec2","frameId":"baseline-frame"},
    {"id":"shared-transfer-box","type":"rectangle","x":1490,"y":635,"width":580,"height":48,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","fillStyle":"solid","roughness":0,"frameId":"baseline-frame"},
    {"id":"shared-transfer-text","type":"text","x":1508,"y":648,"width":545,"height":23,"text":"+ New departure     form appears only on request","fontSize":18,"fontFamily":5,"strokeColor":"#345ec2","frameId":"baseline-frame"},
    {"id":"shared-safety","type":"text","x":990,"y":708,"width":1080,"height":100,"text":"Save feedback stays next to the action. Failed saves keep the previous state.\nHide mutation controls for read-only members. Keep scope visible on every view.\nOwner edits keep their draft until saved or explicitly discarded.\nDestructive actions stay in a labeled menu with confirmation.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"baseline-frame"},

    {"id":"recommend-title","type":"text","x":2170,"y":240,"width":900,"height":38,"text":"My recommendation","fontSize":28,"fontFamily":5,"strokeColor":"#242933","frameId":"baseline-frame"},
    {"id":"recommend-box","type":"rectangle","x":2170,"y":300,"width":900,"height":205,"strokeColor":"#345ec2","backgroundColor":"#eef3fc","fillStyle":"solid","roughness":0,"frameId":"baseline-frame"},
    {"id":"recommend-main","type":"text","x":2200,"y":327,"width":840,"height":38,"text":"Start with A. Compact rows.","fontSize":28,"fontFamily":5,"strokeColor":"#254893","frameId":"baseline-frame"},
    {"id":"recommend-detail","type":"text","x":2200,"y":382,"width":840,"height":90,"text":"It fixes the repeated cost in every item without hiding work.\nAdd B's section summaries if long lists still bury Departures.\nKeep F as a later shortcut from the itinerary.","fontSize":21,"fontFamily":5,"strokeColor":"#242933","frameId":"baseline-frame"},
    {"id":"recommend-reading","type":"text","x":2170,"y":540,"width":900,"height":100,"text":"Read each option left to right.\nDesktop view  >  mobile view  >  transition below.\nThe options compare different navigation models,\nnot six color treatments of the same layout.","fontSize":21,"fontFamily":5,"strokeColor":"#526178","frameId":"baseline-frame"},
    {"id":"recommend-evidence","type":"text","x":2170,"y":680,"width":900,"height":125,"text":"Based on the current ChecklistsPage, ChecklistItemRow,\nDepartureChecklist, AddItemForm and checklist styles.\nSame sample: 5 packing items; 6 checks per departure.\nSketches are not measured space savings.\nNo application behavior is changed by this file.","fontSize":18,"fontFamily":5,"strokeColor":"#647082","frameId":"baseline-frame"},

    {"id":"a-frame","type":"frame","name":"A / Compact rows / smallest change","x":40,"y":960,"width":1500,"height":1120,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","roughness":0},
    {"id":"a-title","type":"text","x":70,"y":990,"width":1430,"height":42,"text":"A. Compact rows, controls on demand","fontSize":30,"fontFamily":5,"strokeColor":"#242933","frameId":"a-frame"},
    {"id":"a-premise","type":"text","x":70,"y":1040,"width":1430,"height":28,"text":"Remove repeated vertical structure. Keep packing and the selected departure visible together.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","frameId":"a-frame"},
    {"id":"a-desktop-label","type":"text","x":70,"y":1083,"width":920,"height":22,"text":"Desktop / two working lists","fontSize":16,"fontFamily":5,"strokeColor":"#647082","frameId":"a-frame"},
    {"id":"a-mobile-label","type":"text","x":1090,"y":1083,"width":390,"height":22,"text":"Mobile / same rows, stacked sections","fontSize":16,"fontFamily":5,"strokeColor":"#647082","frameId":"a-frame"},
