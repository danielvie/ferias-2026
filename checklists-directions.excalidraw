    {"id":"f-state-3-card","type":"rectangle","x":2688,"y":4250,"width":384,"height":110,"strokeColor":"#345ec2","backgroundColor":"#ffffff","fillStyle":"solid","roughness":0,"frameId":"f-frame"},
    {"id":"f-state-3-text","type":"text","x":2702,"y":4265,"width":355,"height":80,"text":"09:00 Brussels > Ghent\n3 checks pending\nOpen departure checks  [focused]","fontSize":17,"fontFamily":5,"strokeColor":"#345ec2","lineHeight":1.5,"frameId":"f-frame"},
    {"id":"f-motion","type":"text","x":1650,"y":4410,"width":1410,"height":52,"text":"220 ms right-edge slide on desktop; 240 ms upward slide on mobile. No background resize. Close reverses the motion.\nUse a modal dialog, contain focus and restore it on Close. Escape closes; guard unsaved drafts. Never require a drag gesture.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"f-frame"},
    {"id":"f-tradeoff","type":"text","x":1650,"y":4495,"width":1410,"height":28,"text":"Best while travelling. Tradeoff: less room for editing; more overlay and focus-management complexity.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"f-frame"},

    {"id":"motion-footer-box","type":"rectangle","x":40,"y":4670,"width":3080,"height":195,"strokeColor":"#cbd2dd","backgroundColor":"#eef3fc","fillStyle":"solid","roughness":0},
    {"id":"motion-footer-title","type":"text","x":70,"y":4695,"width":3000,"height":35,"text":"Motion should explain what changed, not decorate the page.","fontSize":28,"fontFamily":5,"strokeColor":"#254893"},
    {"id":"motion-footer-copy","type":"text","x":70,"y":4748,"width":3000,"height":92,"text":"All timings are proposed interaction timings, not tested performance targets. No entrance animation for ordinary list rows.\nWith reduced motion: switch states immediately, keep focus and save announcements, and preserve the same navigation behavior.\nCounts update only for their own list. Pending / Done / Skipped use text and symbols, not color alone. Reopening a skipped departure check makes it pending.\nPrototype the chosen layout at 390 px with long item names, many departures, read-only access, an unsaved form and a failed save before implementation.","fontSize":20,"fontFamily":5,"strokeColor":"#242933","lineHeight":1.25},

    {"id":"round2-title","type":"text","x":3360,"y":35,"width":1600,"height":60,"text":"Round 2. Keep-style checklist creation","fontSize":40,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"round2-brief","type":"text","x":3360,"y":112,"width":1600,"height":62,"text":"D's list navigator + A's compact rows + the Google Keep editing model.\nThree arrangements of the same editor. City transitions and departure rules are deliberately deferred.","fontSize":21,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.4},
