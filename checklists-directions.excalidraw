    {"id":"e-motion","type":"text","x":70,"y":4410,"width":1410,"height":52,"text":"After save, show a 600 ms acknowledgement, then a 160 ms collapse once focus leaves the row. Keep Undo available for 8 seconds.\nNever remove the focused control. On failure, keep the row pending with Retry. All always exposes resolved items for review.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"e-frame"},
    {"id":"e-tradeoff","type":"text","x":70,"y":4495,"width":1410,"height":28,"text":"Best late in preparation. Tradeoff: mixed scopes require strong labels; finished items are one filter away.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"e-frame"},

