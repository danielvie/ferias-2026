    {"id":"f-layout-note","type":"text","x":1650,"y":4095,"width":1410,"height":46,"text":"Space strategy: no checklist occupies itinerary space until requested. The Checklists index keeps Packing + all departure summaries.\nThe itinerary trigger opens this exact transfer, not whichever departure was selected before. Packing is still a trip-wide list.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"f-frame"},
