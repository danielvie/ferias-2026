    {"id":"d-motion","type":"text","x":1650,"y":3170,"width":1410,"height":52,"text":"180 ms, 24 px directional slide on mobile. Reverse on Back; restore index scroll and focus. Browser Back does the same.\nDesktop swaps only the detail pane with a short crossfade. Direct journey links open the matching detail, not the first departure.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"d-frame"},
    {"id":"d-tradeoff","type":"text","x":1650,"y":3255,"width":1410,"height":28,"text":"Best for a trip with many journeys. Tradeoff: a navigator uses desktop width and adds one mobile navigation step.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"d-frame"},

