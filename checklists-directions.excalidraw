    {"id":"board-title","type":"text","x":60,"y":35,"width":3000,"height":65,"text":"Checklists. Less page, more checking.","fontSize":48,"fontFamily":5,"strokeColor":"#242933","lineHeight":1.25},
    {"id":"board-subtitle","type":"text","x":60,"y":115,"width":3000,"height":50,"text":"Six layout strategies for Belgium, together. Desktop + mobile + interaction storyboards.\nBlue marks an action or selection. Green means done. Amber means skipped, not packed.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.25},

