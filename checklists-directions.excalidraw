    {"id":"g-creation-note","type":"text","x":3390,"y":1594,"width":1540,"height":50,"text":"Enter commits the item and opens the next row. The empty prompt is never an item. Keep the new title and item drafts if saving fails.\nOn mobile, Back returns to the list index with the new checklist selected. No separate modal or multi-field creation form.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"g-frame"},
    {"id":"g-tradeoff","type":"text","x":3390,"y":1662,"width":1540,"height":28,"text":"Recommended. Closest to your A + D feedback. Tradeoff: only one checklist's contents are visible at a time.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"g-frame"},

