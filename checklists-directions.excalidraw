    {"id":"a-state-3-note","type":"text","x":1108,"y":1858,"width":384,"height":23,"text":"Owner saved. Still pending.","fontSize":17,"fontFamily":5,"strokeColor":"#286344","frameId":"a-frame"},
    {"id":"a-motion","type":"text","x":70,"y":1930,"width":1410,"height":52,"text":"120 ms opacity reveal at the trigger. On narrow screens use a small owner sheet. Keep the list still.\nSave returns focus to the owner control. Cancel discards only this draft. Show save errors inside the editor.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"a-frame"},
    {"id":"a-tradeoff","type":"text","x":70,"y":2015,"width":1410,"height":28,"text":"Best first step. Low navigation cost. Tradeoff: very long lists still require scrolling.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"a-frame"},

