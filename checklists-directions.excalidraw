    {"id":"e-layout-note","type":"text","x":70,"y":4095,"width":1410,"height":46,"text":"Space strategy: resolved items leave the default view. This gains more as work finishes; it does not save much when everything is pending.\nNo combined readiness score. Keep packing and departure totals independent. Add item always asks which list receives it.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"e-frame"},
