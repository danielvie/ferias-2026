    {"id":"b-premise","type":"text","x":1650,"y":1040,"width":1430,"height":28,"text":"Give every list a useful one-line summary. Expand only the section being worked on.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","frameId":"b-frame"},
