    {"id":"a-mobile-departure-label","type":"text","x":1118,"y":1532,"width":335,"height":42,"text":"Departures     3 / 6 resolved\nBrussels > Ghent, 12 Jun     scroll below","fontSize":16,"fontFamily":5,"strokeColor":"#526178","frameId":"a-frame","groupIds":["a-mobile"]},
    {"id":"a-layout-note","type":"text","x":70,"y":1615,"width":1410,"height":46,"text":"Space strategy: title, state and owner share one row. No status label above a select. Add forms stay closed until requested.\nDesktop uses spare width; mobile keeps natural page scrolling. Long labels can grow beyond the 44 px minimum.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"a-frame"},
    {"id":"a-transition-title","type":"text","x":70,"y":1665,"width":1400,"height":28,"text":"Transition idea / edit an owner without expanding the whole list","fontSize":20,"fontFamily":5,"strokeColor":"#242933","frameId":"a-frame"},
