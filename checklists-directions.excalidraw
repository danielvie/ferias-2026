    {"id":"h-layout-note","type":"text","x":3390,"y":2650,"width":1540,"height":48,"text":"Same compact editor, no permanent sidebar. Lists opens the named checklist navigator above the page; choosing one replaces the editor.\nLong titles wrap naturally on mobile. New checklist remains inside the navigator and is also a direct desktop action.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"h-frame"},
