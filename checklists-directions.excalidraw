    {"id":"g-layout-note","type":"text","x":3390,"y":1230,"width":1540,"height":48,"text":"The navigator holds named checklists, not cities. Click the title or an item to edit directly. A blank add row replaces the entire add-item form.\nCompleted items sit under their own disclosure with muted, struck-through text. No progress bars, repeated status labels or item cards.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"g-frame"},
