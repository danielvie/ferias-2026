    {"id":"h-creation-note","type":"text","x":3390,"y":3014,"width":1540,"height":50,"text":"A 140 ms fade reveals the navigator without shifting the item rows. Escape closes it and returns focus to Lists.\nOn mobile use a narrow navigation drawer. Preserve drafts before switching; a failed save keeps the draft and a Retry action.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","frameId":"h-frame"},
    {"id":"h-tradeoff","type":"text","x":3390,"y":3082,"width":1540,"height":28,"text":"Best for long item names and small screens. Tradeoff: changing checklists takes an extra click.","fontSize":20,"fontFamily":5,"strokeColor":"#254893","frameId":"h-frame"},

