    {"id":"pick4-title","type":"text","x":11000,"y":30,"width":1400,"height":42,"text":"Checklist picker: four directions","fontSize":32,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"pick4-intro","type":"text","x":11000,"y":85,"width":1450,"height":60,"text":"Same example in each: Packing is available twice, once for the trip and once from Brussels → Ghent.\nChoosing a list creates a fresh, unchecked copy for Ghent → Bruges. Add new creates an editable card.\nThese are proposals only. Existing behavior and code remain unchanged.","fontSize":17,"fontFamily":5,"strokeColor":"#52647a"},

    {"id":"pick-a-head","type":"text","x":11000,"y":190,"width":950,"height":34,"text":"A. Compact rows with source labels","fontSize":25,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"pick-a-sub","type":"text","x":11000,"y":232,"width":1200,"height":24,"text":"Keep every choice in one list. Scope is a small second line, not another card.","fontSize":16,"fontFamily":5,"strokeColor":"#52647a"},
