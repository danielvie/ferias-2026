    {"id":"picker-new-note","type":"text","x":8230,"y":720,"width":450,"height":150,"text":"Add new creates the card.\nThe title is selected for editing.\n\nPicking an existing list creates\nan independent unchecked copy.\n\nA failed save keeps Retry available.","fontSize":17,"fontFamily":5,"strokeColor":"#52647a"},

    {"id":"quiet-title","type":"text","x":9000,"y":30,"width":1350,"height":42,"text":"Selected: quieter checklist controls","fontSize":32,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"quiet-intro","type":"text","x":9000,"y":85,"width":1350,"height":48,"text":"Smaller muted icons and no resting boxes. The indented route connector and checklist picker stay the same.\nEach icon keeps a 44 × 44 target, a tooltip and an accessible name.","fontSize":18,"fontFamily":5,"strokeColor":"#52647a"},
