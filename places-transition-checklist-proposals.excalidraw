    {"id":"compact-state-2","type":"rectangle","x":4360,"y":2430,"width":340,"height":88,"strokeColor":"#8cbda3","backgroundColor":"#edf8f0","fillStyle":"solid","roundness":{"type":3}},
    {"id":"compact-state-2t","type":"text","x":4375,"y":2445,"width":310,"height":55,"text":"Apartment check-out     ✓  ›\nAll checks resolved","fontSize":16,"fontFamily":5,"strokeColor":"#21603e"},
