    {"id":"pick-c-note","type":"text","x":11000,"y":2015,"width":1100,"height":45,"text":"Useful when similar names contain different items. Preview is read-only.\nTradeoff: adding an existing checklist takes two actions instead of one.","fontSize":16,"fontFamily":5,"strokeColor":"#52647a"},

