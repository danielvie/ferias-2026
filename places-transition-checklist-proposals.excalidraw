    {"id":"color-study-notes","type":"text","x":14000,"y":635,"width":1250,"height":110,"text":"Previous surface: #eef2f6    /    hover: #dfe6ed\nSelected surface: #f5f7fb (--paper)    /    hover: #eef3fc (--soft-green)\nThe lighter surface stays visible on white without making the picker feel like a status message.\nUse a visible focus outline and preserve readable text contrast on both backgrounds.","fontSize":17,"fontFamily":5,"strokeColor":"#52647a"},
