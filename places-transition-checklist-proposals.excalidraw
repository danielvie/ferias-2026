    {"id":"icon-behavior-heading","type":"text","x":5700,"y":1280,"width":1200,"height":36,"text":"How the icons behave","fontSize":26,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"icon-behavior","type":"text","x":5700,"y":1330,"width":1500,"height":150,"text":"Each icon is one checklist and opens that checklist in place. Opening another closes the first; closing returns focus to its icon.\nOn hover or keyboard focus, show the checklist title. On touch, tap to reveal the full card. Each icon has a 44 px minimum target.\nAccessible names include the checklist title and both checkpoint identities. Do not rely on color or the icon alone for accessibility.\nCollapsed icons show presence, not readiness. Open a checklist to see its title, pending count and resolved items.\nEditors use the plus icon to create a new list or copy an existing one. Every copied item starts unchecked.","fontSize":17,"fontFamily":5,"strokeColor":"#52647a"},
    {"id":"icon-tradeoff","type":"text","x":5700,"y":1530,"width":1450,"height":65,"text":"Tradeoff: the route stays compact, but titles and outstanding checks are hidden until focus or opening.\nIf many checklists belong to one transition, icons wrap rather than shrink; duplicate titles need distinct accessible labels.","fontSize":17,"fontFamily":5,"strokeColor":"#52647a"},

    {"id":"picker-title","type":"text","x":7500,"y":30,"width":1300,"height":42,"text":"Add a checklist / selected interaction","fontSize":32,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"picker-intro","type":"text","x":7500,"y":85,"width":1400,"height":48,"text":"Choose an existing checklist or add a new one. Both actions open an editable card on the connector.\nAn existing checklist is copied with its items unchecked.","fontSize":18,"fontFamily":5,"strokeColor":"#52647a"},
