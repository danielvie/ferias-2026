    {"id":"pick-d-m-list","type":"text","x":11747,"y":2288,"width":190,"height":220,"text":"Packing\nTrip checklist\n\nPacking\nBrussels → Ghent\n\nDocuments\nTrip checklist\n\n+ Add new","fontSize":15,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"pick-d-m-city2","type":"text","x":11680,"y":2555,"width":260,"height":42,"text":"≡  3  Bruges                  ›\n         0 activities","fontSize":15,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"pick-d-note","type":"text","x":11000,"y":2650,"width":1100,"height":45,"text":"Least visible chrome. The plus changes to a close control while open.\nTradeoff: choice boundaries need a clear hover and keyboard-focus treatment.","fontSize":16,"fontFamily":5,"strokeColor":"#52647a"},

    {"id":"pick-shared-head","type":"text","x":11000,"y":2750,"width":950,"height":34,"text":"Interaction shared across the options","fontSize":25,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"pick-shared","type":"text","x":11000,"y":2800,"width":1450,"height":145,"text":"A, B and D add the selected source immediately. C adds only when Add copy is pressed.\nAdd new opens a new editable checklist card. A copied list starts unchecked; its source does not change.\nTitles wrap. Repeated visits use checkpoint numbers when needed. Long lists scroll; rows remain at least 44 px tall.\nKeyboard focus is visible. Escape closes the picker and returns focus to the plus. Save failures offer Retry.\nRead-only viewers cannot add. Family views do not expose checklist data.","fontSize":17,"fontFamily":5,"strokeColor":"#52647a"},

    {"id":"tab-title","type":"text","x":12500,"y":30,"width":1250,"height":42,"text":"E. Square picker beside the plus","fontSize":32,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"tab-intro","type":"text","x":12500,"y":85,"width":1400,"height":55,"text":"A simple rectangular background holds the list. The plus stays separate alongside the route.\nThe rows below are shown at rest.","fontSize":18,"fontFamily":5,"strokeColor":"#52647a"},
