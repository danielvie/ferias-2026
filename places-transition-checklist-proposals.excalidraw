    {"id":"action-study-notes","type":"text","x":14000,"y":1295,"width":760,"height":90,"text":"Open card: #eef3fc (--soft-green); action hover: white (--surface).\nItem × appears on hover or focus, and stays visible on touch. Deletes immediately.\nTrash opens checklist delete confirmation. × at top closes the checklist.","fontSize":16,"fontFamily":5,"strokeColor":"#52647a"},
