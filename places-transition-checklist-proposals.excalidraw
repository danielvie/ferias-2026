    {"id":"title","type":"text","x":40,"y":30,"width":1100,"height":40,"text":"Places: checks between checkpoints","fontSize":32,"fontFamily":5,"strokeColor":"#172b4d"},
    {"id":"intro","type":"text","x":40,"y":85,"width":1500,"height":48,"text":"Three proposals for the same Brussels → Ghent journey. Blue controls open the exact journey; checks are illustrative.\nDesign exploration only. No application behavior or data relationships have been changed.","fontSize":18,"fontFamily":5,"strokeColor":"#52647a"},

