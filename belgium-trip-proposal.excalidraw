    {"id":"privacy-text","type":"text","x":94,"y":2444,"width":990,"height":95,"angle":0,"strokeColor":"#674c18","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"groupIds":[],"seed":103,"version":1,"isDeleted":false,"text":"PRIVATE BY DEFAULT\nNotes start private. Choose \"Trip members\" when you want to share one.\nFamily links exclude notes, checklists, exact stay addresses and booking details.\nAnyone with that link can see its selected content. Preview it before sharing; revoke anytime.","fontSize":19,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"PRIVATE BY DEFAULT\nNotes start private. Choose \"Trip members\" when you want to share one.\nFamily links exclude notes, checklists, exact stay addresses and booking details.\nAnyone with that link can see its selected content. Preview it before sharing; revoke anytime.","autoResize":true,"lineHeight":1.25},

