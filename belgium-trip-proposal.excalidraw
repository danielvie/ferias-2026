    {"id":"rain-text","type":"text","x":1805,"y":2336,"width":462,"height":112,"angle":0,"strokeColor":"#315477","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"groupIds":[],"seed":122,"version":1,"isDeleted":false,"text":"4. GROUP CHOICES + RAIN PLANS\nVote on saved places. Tag indoor options.\nAttach a backup to a planned activity.\nA forecast can help later, not auto-replan.","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"4. GROUP CHOICES + RAIN PLANS\nVote on saved places. Tag indoor options.\nAttach a backup to a planned activity.\nA forecast can help later, not auto-replan.","autoResize":true,"lineHeight":1.35},
    {"id":"roadmap-later","type":"text","x":1252,"y":2496,"width":1020,"height":65,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"groupIds":[],"seed":123,"version":1,"isDeleted":false,"text":"Later: emergency / insurance contacts, reminders, photo journal, calendar export.\nKeep out of v1: live train tracking, automatic booking imports and AI-generated itineraries.","fontSize":19,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Later: emergency / insurance contacts, reminders, photo journal, calendar export.\nKeep out of v1: live train tracking, automatic booking imports and AI-generated itineraries.","autoResize":true,"lineHeight":1.4},
