    {"id":"title","type":"text","x":60,"y":35,"width":2500,"height":60,"text":"Checklists. From two layouts to one shared dial.","fontSize":42,"fontFamily":5,"strokeColor":"#242933"},
    {"id":"brief","type":"text","x":60,"y":112,"width":2480,"height":60,"text":"Current implementation: U1, in the final three frames. Desktop G + mobile M1 remain as the earlier baseline.\nThe latest frame records compact hover summaries, grip sorting, the dark drag state and clean item options.","fontSize":21,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.4},

