    {"id":"u1-hover-size-note","type":"text","x":80,"y":6500,"width":720,"height":164,"text":"Actual card: fit content; max width 256 px.\n10 / 12 px padding, 14 px title, 12 px count.\nTicks: 7 px rest / 16.38 px hover / 11.69 px neighbors.\nNumbers stay fixed; ordinary / active thickness stays 2 / 3 px.\nThe card shows the total count, including completed items.\nHover and keyboard focus share the same behavior.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"u1-refinements-frame"},
    {"id":"u1-grip-study-title","type":"text","x":920,"y":5870,"width":720,"height":34,"text":"Grip-only reordering","fontSize":24,"fontFamily":5,"strokeColor":"#242933","frameId":"u1-refinements-frame"},
    {"id":"u1-normal-grip-1","type":"text","x":936,"y":6004,"width":44,"height":44,"text":"⠿","fontSize":32,"fontFamily":5,"strokeColor":"#647082","frameId":"u1-refinements-frame"},
    {"id":"u1-normal-check-1","type":"rectangle","x":990,"y":6008,"width":40,"height":40,"strokeColor":"#647082","roughness":0,"frameId":"u1-refinements-frame"},
