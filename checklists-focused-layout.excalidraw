    {"id":"dial-picker-documents","type":"text","x":366,"y":2434,"width":230,"height":25,"text":"2  Documents","fontSize":19,"fontFamily":5,"strokeColor":"#526178","frameId":"dial-frame"},
    {"id":"dial-picker-groceries","type":"text","x":632,"y":2434,"width":230,"height":25,"text":"3  Groceries","fontSize":19,"fontFamily":5,"strokeColor":"#526178","frameId":"dial-frame"},
    {"id":"dial-picker-leaving","type":"text","x":898,"y":2434,"width":250,"height":25,"text":"4  Before leaving","fontSize":19,"fontFamily":5,"strokeColor":"#526178","frameId":"dial-frame"},
    {"id":"dial-picker-note","type":"text","x":80,"y":2540,"width":1100,"height":84,"text":"The picker is enlarged here. On the phone, show the same names in a vertical sheet.\nTick numbers mean checklist order, not trip dates. Use named labels for screen readers.\nKeep each tap target at least 44 px high; scroll the dial when there are too many lists.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"dial-frame"},
    {"id":"dial-tradeoff","type":"text","x":80,"y":2670,"width":1100,"height":60,"text":"Most familiar if you like the itinerary dial.\nTradeoff: the dial takes item width, and long checklists make a longer page.","fontSize":21,"fontFamily":5,"strokeColor":"#254893","lineHeight":1.4,"frameId":"dial-frame"},

    {"id":"strip-frame","type":"frame","name":"Mobile M2 / Named navigator strip + inline editor","x":1340,"y":1270,"width":1220,"height":1500,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","roughness":0},
    {"id":"strip-title","type":"text","x":1380,"y":1300,"width":1140,"height":42,"text":"M2. Earlier alternative / not selected","fontSize":30,"fontFamily":5,"strokeColor":"#242933","frameId":"strip-frame"},
    {"id":"strip-premise","type":"text","x":1380,"y":1356,"width":1140,"height":56,"text":"Fold G's left navigator into a short, always-visible strip of checklist names. Edit one list below it.\nYou can switch lists or create another without leaving the editor.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.4,"frameId":"strip-frame"},
    {"id":"strip-before-label","type":"text","x":1380,"y":1434,"width":390,"height":26,"text":"Packing is selected / 390 px","fontSize":18,"fontFamily":5,"strokeColor":"#647082","frameId":"strip-frame"},
    {"id":"strip-after-label","type":"text","x":2090,"y":1434,"width":390,"height":26,"text":"New checklist / keyboard open","fontSize":18,"fontFamily":5,"strokeColor":"#647082","frameId":"strip-frame"},
