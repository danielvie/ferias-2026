    {"id":"u1-create-note","type":"text","x":1780,"y":5260,"width":700,"height":92,"text":"Save the title, then focus its first item.\nEnter adds the item and readies the next row.\nFailed saves keep the draft available for retry.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"u1-flow-frame"},
