    {"id":"u1-change-rules","type":"text","x":2150,"y":4110,"width":350,"height":160,"text":"Remove left navigator.\nShow every list in order.\nUse the mobile dial.\nLimit the reading width.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.9,"frameId":"u1-layout-frame"},
    {"id":"u1-layout-caption","type":"text","x":80,"y":4374,"width":2400,"height":58,"text":"Extra desktop width becomes margins, not another navigation model. The list order, editing and completed sections stay the same.\nThe dial belongs to the workspace edge and stays below the actual app header, clear of the New button.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"u1-layout-frame"},

