    {"id":"u1-dark-drag-grip","type":"text","x":930,"y":6136,"width":44,"height":44,"text":"⠿","fontSize":32,"fontFamily":5,"strokeColor":"#d0d3d8","frameId":"u1-refinements-frame"},
    {"id":"u1-dark-drag-text","type":"text","x":1010,"y":6138,"width":560,"height":40,"text":"Phone charger","fontSize":28,"fontFamily":5,"strokeColor":"#ffffff","frameId":"u1-refinements-frame"},
    {"id":"u1-normal-grip-2","type":"text","x":936,"y":6240,"width":44,"height":44,"text":"⠿","fontSize":32,"fontFamily":5,"strokeColor":"#647082","frameId":"u1-refinements-frame"},
    {"id":"u1-normal-check-2","type":"rectangle","x":990,"y":6244,"width":40,"height":40,"strokeColor":"#647082","roughness":0,"frameId":"u1-refinements-frame"},
    {"id":"u1-normal-text-2","type":"text","x":1050,"y":6244,"width":520,"height":40,"text":"Medication","fontSize":28,"fontFamily":5,"strokeColor":"#242933","frameId":"u1-refinements-frame"},
    {"id":"u1-grip-rules","type":"text","x":920,"y":6500,"width":720,"height":164,"text":"Pointer, touch and keyboard use the same saved order.\nSpace picks up; arrows move; Space drops; Escape cancels.\nPending and completed items reorder in separate sections.\nThe rest of the row remains editable and scrollable.\nOnly the floating row gets the dark background and light text.\nIDs, text, assignment and completion do not change.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"u1-refinements-frame"},
    {"id":"u1-options-study-title","type":"text","x":1760,"y":5870,"width":720,"height":34,"text":"Options / one compact trigger","fontSize":24,"fontFamily":5,"strokeColor":"#242933","frameId":"u1-refinements-frame"},
    {"id":"u1-options-row-grip","type":"text","x":1780,"y":6004,"width":44,"height":44,"text":"⠿","fontSize":32,"fontFamily":5,"strokeColor":"#647082","frameId":"u1-refinements-frame"},
