    {"id":"save-error","type":"text","x":1210,"y":962,"width":580,"height":98,"text":"Couldn't save. Your draft is still here.\n[  ]  Phone charger |\nRetry","fontSize":20,"fontFamily":5,"strokeColor":"#806318","lineHeight":1.6,"frameId":"desktop-frame"},
    {"id":"save-rule","type":"text","x":1850,"y":958,"width":670,"height":112,"text":"Do not navigate away from a failed draft silently.\nKeep list IDs and selection across screen sizes.\nNo row rearrangement while someone is typing.\nSave feedback stays beside the editor.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.45,"frameId":"desktop-frame"},

