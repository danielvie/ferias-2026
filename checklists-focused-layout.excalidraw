    {"id":"strip-keyboard-keys","type":"text","x":2110,"y":1972,"width":350,"height":150,"text":"Q  W  E  R  T  Y  U  I  O  P\n  A  S  D  F  G  H  J  K  L\n    Z  X  C  V  B  N  M","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":2.8,"frameId":"strip-frame","groupIds":["strip-after"]},
    {"id":"strip-keyboard-space","type":"rectangle","x":2160,"y":2138,"width":180,"height":44,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","fillStyle":"solid","roughness":0,"frameId":"strip-frame","groupIds":["strip-after"]},
