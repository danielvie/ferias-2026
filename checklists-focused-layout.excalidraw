    {"id":"u1-flow-caption","type":"text","x":80,"y":4670,"width":2400,"height":28,"text":"These are interaction states, not additional layout alternatives. No new routes, persistence model or city behavior.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","frameId":"u1-flow-frame"},
