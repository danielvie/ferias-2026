    {"id":"desktop-caption","type":"text","x":70,"y":304,"width":2450,"height":28,"text":"Historical baseline. U1 below replaces this split layout with the mobile dial and continuous checklist page.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","frameId":"desktop-frame"},
