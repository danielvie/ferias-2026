    {"id":"u1-options-move-up","type":"text","x":1924,"y":6380,"width":248,"height":30,"text":"Move earlier","fontSize":20,"fontFamily":5,"strokeColor":"#345ec2","frameId":"u1-refinements-frame"},
    {"id":"u1-options-move-down","type":"text","x":2188,"y":6380,"width":248,"height":30,"text":"Move later","fontSize":20,"fontFamily":5,"strokeColor":"#345ec2","frameId":"u1-refinements-frame"},
    {"id":"u1-options-delete","type":"text","x":1924,"y":6442,"width":512,"height":30,"text":"Delete item","fontSize":20,"fontFamily":5,"strokeColor":"#345ec2","frameId":"u1-refinements-frame"},
    {"id":"u1-options-note","type":"text","x":1780,"y":6600,"width":700,"height":108,"text":"No extra + / − disclosure glyph above the dots.\nThe trigger stays 44 px high when open or closed.\nMove earlier / later provide a non-drag alternative.\nDeletion still requires confirmation.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"u1-refinements-frame"},
    {"id":"u1-refinements-footer","type":"text","x":80,"y":6770,"width":2400,"height":56,"text":"Reorder saves use revision checks and preserve stable item identities. Failed or conflicting saves keep the saved order visible.\nHover and focus summaries are read-only; touch taps remain direct jumps. No city-transition behavior is added.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.4,"frameId":"u1-refinements-frame"}
