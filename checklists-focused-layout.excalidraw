    {"id":"u1-resize-note","type":"text","x":100,"y":5470,"width":2380,"height":72,"text":"Keep the active checklist and in-panel drafts. Checking an item never jumps to another list.\nThe dial stays below the app header and clear of New. Long dials scroll; reduced motion jumps instantly.\nNo sidebar at any breakpoint. No changes to checklist data, permissions, departure checks or city transitions.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.35,"frameId":"u1-flow-frame"},

