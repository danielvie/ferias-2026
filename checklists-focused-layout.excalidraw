    {"id":"dial-behavior","type":"text","x":80,"y":2240,"width":1100,"height":60,"text":"Borrow the itinerary's visual dial. On mobile, tap jumps directly instead of opening a read-only preview first.\nThe active marker follows scrolling. Adding a checklist appends it and focuses its title in the same page.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"dial-frame"},
