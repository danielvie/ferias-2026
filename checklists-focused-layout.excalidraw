    {"id":"strip-keyboard-next","type":"text","x":2384,"y":2150,"width":64,"height":25,"text":"Next","fontSize":19,"fontFamily":5,"strokeColor":"#345ec2","frameId":"strip-frame","groupIds":["strip-after"]},
    {"id":"strip-behavior","type":"text","x":1380,"y":2240,"width":1100,"height":60,"text":"Tap a name to replace the selected editor, not navigate to a new screen. More opens a picker with every full title.\nThe new checklist stays selected and visible in the strip. No tiny sidebar, Back button or full-page list index.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"strip-frame"},
    {"id":"strip-creation-box","type":"rectangle","x":1380,"y":2340,"width":1100,"height":170,"strokeColor":"#cbd2dd","backgroundColor":"#f5f7fb","fillStyle":"solid","roughness":0,"frameId":"strip-frame"},
    {"id":"strip-creation-title","type":"text","x":1400,"y":2360,"width":1060,"height":30,"text":"Keep creation usable when the keyboard is open","fontSize":22,"fontFamily":5,"strokeColor":"#242933","frameId":"strip-frame"},
    {"id":"strip-creation-sequence","type":"text","x":1400,"y":2420,"width":1060,"height":58,"text":"Title  >  first item  >  Enter  >  next item\nScroll the focused row above the keyboard. Keep the list selector visible; do not reset the draft on resize.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"strip-frame"},
    {"id":"strip-picker-note","type":"text","x":1380,"y":2540,"width":1100,"height":84,"text":"Only a few names need to fit in the strip. More always exposes the full collection.\nLong checklist names wrap in the picker, never become indistinguishable abbreviations.\nSwitching lists preserves each editor's scroll position. A failed draft stays until saved or explicitly discarded.","fontSize":18,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5,"frameId":"strip-frame"},
    {"id":"strip-tradeoff","type":"text","x":1380,"y":2670,"width":1100,"height":60,"text":"My pick for everyday phone editing. Named lists and full item width.\nTradeoff: the strip uses some vertical space; distant lists need the More picker.","fontSize":21,"fontFamily":5,"strokeColor":"#254893","lineHeight":1.4,"frameId":"strip-frame"},

    {"id":"decision-box","type":"rectangle","x":40,"y":2890,"width":2520,"height":270,"strokeColor":"#345ec2","backgroundColor":"#eef3fc","fillStyle":"solid","roughness":0},
    {"id":"decision-title","type":"text","x":70,"y":2918,"width":2460,"height":40,"text":"U1 is implemented. One dial now serves desktop and mobile.","fontSize":29,"fontFamily":5,"strokeColor":"#254893"},
    {"id":"decision-dial","type":"text","x":70,"y":2980,"width":1160,"height":90,"text":"Earlier baseline: desktop G + mobile M1.\nU1 removes the desktop sidebar and shows every checklist in order.\nThe final frames are the current implementation reference.","fontSize":21,"fontFamily":5,"strokeColor":"#242933","lineHeight":1.4},
    {"id":"decision-safety","type":"text","x":1370,"y":2980,"width":1150,"height":118,"text":"Keep compact rows, completed sections and in-panel draft retention.\nNo automatic jumping after checking an item. No new city interactions.\nMain's confirmation policy still applies: only deletion requires confirmation.\nU1 changes navigation and spacing, not persistence or permissions.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.5},

    {"id":"u1-layout-frame","type":"frame","name":"U1 / Implemented shared dial on desktop and mobile","x":40,"y":3280,"width":2520,"height":1220,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","roughness":0},
    {"id":"u1-title","type":"text","x":80,"y":3310,"width":2400,"height":44,"text":"U1. One checklist page. One dial at every width.","fontSize":32,"fontFamily":5,"strokeColor":"#242933","frameId":"u1-layout-frame"},
    {"id":"u1-brief","type":"text","x":80,"y":3366,"width":2400,"height":56,"text":"Implemented U1. Desktop and mobile share the same interaction and visual language, without a left navigator.\nPanel-only views below. The app header stays unchanged.","fontSize":20,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.4,"frameId":"u1-layout-frame"},
    {"id":"u1-desktop-label","type":"text","x":80,"y":3430,"width":1440,"height":26,"text":"Desktop / 1440 px / continuous checklists, no selected-list card","fontSize":18,"fontFamily":5,"strokeColor":"#647082","frameId":"u1-layout-frame"},
    {"id":"u1-phone-label","type":"text","x":1690,"y":3430,"width":390,"height":26,"text":"Mobile / 390 px / same structure","fontSize":18,"fontFamily":5,"strokeColor":"#647082","frameId":"u1-layout-frame"},
    {"id":"u1-desktop-screen","type":"rectangle","x":80,"y":3470,"width":1440,"height":860,"strokeColor":"#cbd2dd","backgroundColor":"#ffffff","fillStyle":"solid","roughness":0,"frameId":"u1-layout-frame","groupIds":["u1-desktop"]},
