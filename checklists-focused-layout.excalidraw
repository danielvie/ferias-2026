    {"id":"row-caption","type":"text","x":1190,"y":854,"width":1330,"height":54,"text":"Tap text to edit. Enter adds the next item. An empty prompt is never saved as an item.\nKeep row actions available to touch and keyboard. Completed items can be reopened.","fontSize":19,"fontFamily":5,"strokeColor":"#526178","lineHeight":1.4,"frameId":"desktop-frame"},
